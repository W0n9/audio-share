{
  "id": "control.error-204-authorization-denied",
  "category": "control-error-registry",
  "spec_cite": [
    "docs/wire-protocol-v2/spec.md §5.2 (AuthProof valid, identity revoked/denied -> AuthResult(204))",
    "docs/wire-protocol-v2/spec.md §6.2 (204 AUTHORIZATION_DENIED: retryable=no, re-pairing=no — admin action)"
  ],
  "description": "Valid signature, revoked identity: AuthResult(204) — the denial is an admin matter, not a re-pairing matter.",
  "preconditions": [
    "Same exchange bytes as control.auth-happy-path; the Server's record for this public key exists with state=revoked (pairing.md §8.1) or has been deleted.",
    "The authorization state is consulted at every AuthInit; no cache outlives the store (pairing.md §9.2)."
  ],
