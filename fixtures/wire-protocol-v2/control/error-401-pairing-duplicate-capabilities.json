{
  "id": "control.error-401-pairing-duplicate-capabilities",
  "category": "control-error-registry",
  "spec_cite": [
    "docs/wire-protocol-v2/spec.md §4.4 (validation table: PairingRequest capabilities duplicated or not ascending -> 401)",
    "docs/wire-protocol-v2/pairing.md §6.3 (canonical form: unique, ascending numeric order)"
  ],
  "description": "PairingRequest with a duplicated capability id ([3, 3]): no canonical form exists, the list is malformed -> Error(401)+Close(401), not a 201 pairing rejection.",
