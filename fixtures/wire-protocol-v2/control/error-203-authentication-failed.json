{
  "id": "control.error-203-authentication-failed",
  "category": "control-error-registry",
  "spec_cite": [
    "docs/wire-protocol-v2/spec.md §5.2 (AuthProof signature invalid -> AuthResult(203); 5th failure -> Close(203))",
    "docs/wire-protocol-v2/spec.md §6.2 (203 AUTHENTICATION_FAILED: retryable=no, re-pairing=yes)"
  ],
  "description": "Invalid signature: the AuthProof is the happy-path signature with one bit flipped in s — verification fails, AuthResult(203) is sent and the failure counted.",
  "preconditions": [
    "Same exchange as control.auth-happy-path; the identity record exists and is active, but the signature does not verify.",
    "This is failure 1 of at most 5 on this connection; the 5th failure closes with Close(203) instead (spec §5.2, TM-4)."
  ],
