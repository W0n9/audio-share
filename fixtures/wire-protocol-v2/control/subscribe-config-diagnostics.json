      "dir": "S->C",
      "channel": "control-stream",
      "message": "unsubscribe_response",
      "frame_hex": "0000000e9a020b0902000000000000001200",
      "body_hex": "9a020b0902000000000000001200",
      "length": 14,
      "decoded": {
        "request_id": 2,
        "status": {}
