    {
      "kind": "frame",
      "index": 6,
      "dir": "S->C",
      "channel": "control-stream",
      "message": "stream_ended",
      "frame_hex": "000000168a0313080110f6031a0c756e73756273637269626564",
      "body_hex": "8a0313080110f6031a0c756e73756273637269626564",
      "length": 22,
      "decoded": {
