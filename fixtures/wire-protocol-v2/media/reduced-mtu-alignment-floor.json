{
  "id": "media.reduced-mtu-alignment-floor",
  "category": "media-plane",
  "spec_cite": [
    "docs/wire-protocol-v2/spec.md §7.3 (frames per datagram = floor(payload_max / frame_bytes); payload always frame-aligned)"
  ],
  "description": "Payload alignment under an awkward limit: with mds = 1165, payload_max = 1141, so the sender sends floor(1141 / 8) = 142 frames = 1136 bytes — the 5-byte remainder is never sent as a partial sample frame.",
  "preconditions": [
    "Session PLAYING; instance 6, generation 1; 48 kHz stereo F32LE; current max_datagram_size() = 1165 (illustrative reduced-MTU value exercising the floor)."
  ],
  "steps": [
    {
      "kind": "datagram",
      "index": 1,
      "dir": "S->C",
      "channel": "datagram",
      "datagram_hex": "",
      "length": 1160,
      "decoded": {
        "stream_instance_id": 6,
        "config_generation": 1,
        "sequence": 0,
        "timestamp": 0,
        "flags": "0x00000001",
        "flags_set": [
          "STREAM_START"
        ],
        "payload_bytes": 1136,
        "payload_frames": 142,
        "frame_bytes": 8
      },
      "note": "142 frames = 1136 B payload; 1136 % 8 == 0; payload < payload_max (1141)."
    },
    {
      "kind": "datagram",
      "index": 2,
      "dir": "S->C",
      "channel": "datagram",
      "datagram_hex": "",
      "length": 1160,
      "decoded": {
        "stream_instance_id": 6,
        "config_generation": 1,
        "sequence": 1,
        "timestamp": 142,
        "flags": "0x00000000",
        "flags_set": [],
        "payload_bytes": 1136,
        "payload_frames": 142,
        "frame_bytes": 8
      },
      "note": "Next datagram: timestamps advance by 142 frames."
    }
  ],
  "assertions": [
    "payload_len % (bytes_per_sample × channels) == 0 for EVERY datagram (§7.3) — a datagram whose payload is not frame-aligned is malformed media and is dropped (§7.5, see media/malformed-drop).",
    "The sender re-chunks rather than skips: the 5 unsendable bytes stay in the capture callback's remainder for the next datagram (§7.3).",
    "Senders re-query the limit per send; a path-limit reduction takes effect on the next datagram (§7.3, D2)."
  ]
}
